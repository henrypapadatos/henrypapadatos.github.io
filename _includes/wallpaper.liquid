<style>
  html { background-color: var(--global-bg-color); }
  body { background-color: transparent !important; }
  #wp-bg-host {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--global-bg-color);
  }
  #wp-bg-host canvas { display: block; width: 100%; height: 100%; }
</style>

<div id="wp-bg-host"></div>

<script>
(function() {
  const PRESET = {
    gridSize: 80,
    gridSizeMobile: 18,
    warpStrength: 7,
    warpRadius: 142,
    clickForce: 3,
    particleSize: 0.45,
    lineAlpha: 0.11
  };

  const mobileMQ = window.matchMedia('(max-width: 768px)');
  function effectiveGridSize() {
    return mobileMQ.matches ? PRESET.gridSizeMobile : PRESET.gridSize;
  }
  // Rebuild mesh when crossing the mobile breakpoint, and reset mouse off-screen
  // when entering mobile so any stale hover position doesn't keep warping.
  mobileMQ.addEventListener('change', () => {
    if (typeof buildHexMesh === 'function') buildHexMesh();
    if (mobileMQ.matches && typeof mouse !== 'undefined') {
      mouse.x = -1e6; mouse.y = -1e6;
      smoothMouse.x = -1e6; smoothMouse.y = -1e6;
    }
  });

  const THEME_LIGHT = { bg: '#efd9c4', primary: '#1a5a8a', intensity: 0.6 };
  const THEME_DARK  = { bg: '#1c1c1d', primary: '#2698ba', intensity: 0.8 };

  function hexToRgb(hex) {
    const v = hex.replace('#', '');
    return [
      parseInt(v.slice(0,2), 16),
      parseInt(v.slice(2,4), 16),
      parseInt(v.slice(4,6), 16)
    ];
  }

  function currentTheme() {
    return document.documentElement.getAttribute('data-theme') === 'dark' ? THEME_DARK : THEME_LIGHT;
  }
  let theme = currentTheme();
  let primaryRgb = hexToRgb(theme.primary);
  let colorRgb = `${primaryRgb[0]}, ${primaryRgb[1]}, ${primaryRgb[2]}`;

  const host = document.getElementById('wp-bg-host');
  if (!host) return;
  host.style.background = theme.bg;

  const themeObserver = new MutationObserver(() => {
    theme = currentTheme();
    primaryRgb = hexToRgb(theme.primary);
    colorRgb = `${primaryRgb[0]}, ${primaryRgb[1]}, ${primaryRgb[2]}`;
    host.style.background = theme.bg;
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  let dpr = window.devicePixelRatio || 1;
  const canvas = document.createElement('canvas');
  canvas.width = window.innerWidth * dpr;
  canvas.height = window.innerHeight * dpr;
  host.appendChild(canvas);
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let particles = [];
  let edges = [];

  function buildHexMesh() {
    particles = [];
    edges = [];
    const w = canvas.width, h = canvas.height;
    const sqrt3 = Math.sqrt(3);
    const hexCols = Math.max(2, Math.round(effectiveGridSize() / 2));
    const s = w / (hexCols * sqrt3);
    const hexW = sqrt3 * s;
    const rowStep = 1.5 * s;
    const hexRows = Math.ceil(h / rowStep) + 2;

    const vertexMap = new Map();
    function addVertex(x, y) {
      const key = `${Math.round(x)},${Math.round(y)}`;
      if (vertexMap.has(key)) return vertexMap.get(key);
      const idx = particles.length;
      vertexMap.set(key, idx);
      particles.push({ x, y, ox: x, oy: y });
      return idx;
    }
    const edgeSet = new Set();
    function addEdge(a, b) {
      const k = a < b ? `${a}-${b}` : `${b}-${a}`;
      if (edgeSet.has(k)) return;
      edgeSet.add(k);
      edges.push([a, b]);
    }
    for (let hr = -1; hr <= hexRows; hr++) {
      for (let hc = -1; hc <= hexCols + 1; hc++) {
        const cx = hc * hexW + (Math.abs(hr) % 2 !== 0 ? hexW / 2 : 0);
        const cy = hr * rowStep;
        const vs = [];
        for (let k = 0; k < 6; k++) {
          const angle = Math.PI / 6 + k * Math.PI / 3;
          vs.push(addVertex(cx + Math.cos(angle) * s, cy + Math.sin(angle) * s));
        }
        for (let k = 0; k < 6; k++) addEdge(vs[k], vs[(k + 1) % 6]);
      }
    }
  }

  buildHexMesh();

  // On mobile, skip continuous mouse tracking — finger touch leaves a sticky
  // warp where you lifted off. Only taps (click events) create impulses.
  const initialMouse = mobileMQ.matches
    ? { x: -1e6, y: -1e6 }
    : { x: window.innerWidth * 0.5 * dpr, y: window.innerHeight * 0.5 * dpr };
  let mouse = { x: initialMouse.x, y: initialMouse.y };
  let smoothMouse = { x: mouse.x, y: mouse.y };
  let click = { x: -1e6, y: -1e6, time: -100 };
  const startTime = performance.now();

  window.addEventListener('mousemove', e => {
    if (mobileMQ.matches) return;
    mouse.x = e.clientX * dpr;
    mouse.y = e.clientY * dpr;
    wake(800);
  });
  window.addEventListener('click', e => {
    if (e.target.closest('a, button, input, textarea, select')) return;
    click.x = e.clientX * dpr;
    click.y = e.clientY * dpr;
    click.time = (performance.now() - startTime) / 1000;
    wake(2500); // click ripple lasts ~2s, plus settle buffer
  });
  window.addEventListener('resize', () => {
    dpr = window.devicePixelRatio || 1;
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    buildHexMesh();
    wake(1500);
  });

  function frame() {
    const t = (performance.now() - startTime) / 1000;
    smoothMouse.x += (mouse.x - smoothMouse.x) * 0.1;
    smoothMouse.y += (mouse.y - smoothMouse.y) * 0.1;

    const w = canvas.width, h = canvas.height;
    const warpStrength = PRESET.warpStrength * dpr;
    const warpRadius = PRESET.warpRadius * dpr;
    const wr2 = warpRadius * warpRadius * 0.5;
    const intensity = theme.intensity;
    const clickAge = t - click.time;

    ctx.fillStyle = theme.bg;
    ctx.fillRect(0, 0, w, h);

    for (const p of particles) {
      const dx = p.ox - smoothMouse.x, dy = p.oy - smoothMouse.y;
      const dist = Math.sqrt(dx*dx + dy*dy);
      let tx = p.ox, ty = p.oy;
      if (dist < warpRadius) {
        const fall = Math.exp(-(dist*dist) / wr2);
        tx += (dx / (dist + 0.01)) * fall * warpStrength;
        ty += (dy / (dist + 0.01)) * fall * warpStrength;
      }
      if (clickAge >= 0 && clickAge < 2) {
        const cdx = p.ox - click.x, cdy = p.oy - click.y;
        const cdist = Math.sqrt(cdx*cdx + cdy*cdy);
        const wave = clickAge * 700 * dpr;
        const diff = Math.abs(cdist - wave);
        if (diff < 100 * dpr) {
          const f = (1 - diff / (100 * dpr)) * (1 - clickAge / 2) * warpStrength * PRESET.clickForce;
          tx += (cdx / (cdist + 0.01)) * f;
          ty += (cdy / (cdist + 0.01)) * f;
        }
      }
      p.x += (tx - p.x) * 0.2;
      p.y += (ty - p.y) * 0.2;
    }

    // Optimization #1: batch all edges into a single path + single stroke()
    ctx.lineWidth = 0.5 * dpr;
    ctx.strokeStyle = `rgba(${colorRgb}, ${PRESET.lineAlpha * intensity})`;
    ctx.beginPath();
    for (const [a, b] of edges) {
      const pa = particles[a], pb = particles[b];
      ctx.moveTo(pa.x, pa.y);
      ctx.lineTo(pb.x, pb.y);
    }
    ctx.stroke();

    // Particles: also a single path
    ctx.fillStyle = `rgba(${colorRgb}, ${0.7 * intensity})`;
    const r = PRESET.particleSize * dpr;
    ctx.beginPath();
    for (const p of particles) {
      ctx.moveTo(p.x + r, p.y);
      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
    }
    ctx.fill();

    // Optimization #3: stop rAF when nothing is changing.
    // Wake on mouse/click; sleep when wakeUntil expires AND mesh is settled.
    const settled = Math.abs(mouse.x - smoothMouse.x) < 0.3
                 && Math.abs(mouse.y - smoothMouse.y) < 0.3;
    if (performance.now() < wakeUntil || !settled) {
      requestAnimationFrame(frame);
    } else {
      isLooping = false;
    }
  }

  let wakeUntil = 0;
  let isLooping = false;
  function wake(durationMs) {
    wakeUntil = Math.max(wakeUntil, performance.now() + durationMs);
    if (!isLooping) {
      isLooping = true;
      requestAnimationFrame(frame);
    }
  }
  // Initial paint + 1.5s settle (mesh particles need a few frames to converge)
  wake(1500);
})();
</script>
